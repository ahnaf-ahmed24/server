PORT=5000
DB_NAME=studiospace
MONGODB_URI=mongodb://127.0.0.1:27017

# Long random string used to sign JWTs
JWT_SECRET=replace_this_with_a_long_random_secret

# Comma separated list of allowed frontend origins (CORS + OAuth redirects)
CLIENT_ORIGINS=http://localhost:3000

# Public HTTPS URL of the API in production (Render), used as OAuth redirect base
PUBLIC_API_URL=

# Google OAuth client (Google Cloud Console -> Credentials -> OAuth Client ID)
# Register this callback URL on the provider console:
#   http://localhost:5000/api/auth/google/callback   (public one in prod)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Register this callback URL:
#   http://localhost:5000/api/auth/github/callback   (public one in prod)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub OAuth app (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

NODE_ENV=development
